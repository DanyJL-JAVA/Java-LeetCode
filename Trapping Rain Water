	public static void TwoSum(Integer[] arr, Integer target) {

		List<Integer> arrlst = new ArrayList<Integer>();

		for (int i = 0; i < arr.length; i++) {

			Integer r = target - arr[i];

			if (arrlst.contains(r)) {

				System.out.println(
						arr[i] + "[Index = " + i + "] + " + r + "[Index = " + arrlst.indexOf(r) + "] = " + target);

			}

			arrlst.add(arr[i]);

		}

	}

