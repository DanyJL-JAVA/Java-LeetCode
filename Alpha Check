import java.util.*;
import java.util.stream.*;

public class Main {

	public static boolean alphaCheck(String s) {

		System.out.println(s.replaceAll("\\s+", "").replaceAll("[^a-z]", "").replaceAll("(.)(?=.*\\1)", "").chars()
				.mapToObj(c -> (char) c).sorted(Comparator.naturalOrder()).map(Object::toString)
				.map(String::toUpperCase).collect(Collectors.joining(" ")));

		return s.replaceAll("\\s+", "").replaceAll("[^a-z]", "").replaceAll("(.)(?=.*\\1)", "").length() == 26;

	}

	public static void main(String[] args) {

		Main obj = new Main();

		String s = "fdnlsalbdc3@$2aubcd85efwghij@$klmn2x329*(*$opqyrst4l2vzlbrfh8094kjfg";

		boolean result = obj.alphaCheck(s);

		System.out.println(result);

	}

}


// * NOTE : Regex Expression

// \\ => Defines "All".
// s+ => empty Space.
// "" => Removing
// [a-z] => a to z
// ^ => Not
// [^a-z] => Only accepts small alphabet letters.
// Part : 1 (.)
// . = any single character
// () = capture that character into Group 1
// Part : 2 (?=.*\\1) 
// ?= = Think of it as: "Before I accept this match, let me look ahead and verify something."
// . = any character
// * = zero or more times
// \1 = Match whatever was captured in Group 1.




