import java.util.*;
import java.util.stream.*;

public class Main {

	public static Integer[] ProExSelf(Integer[] arr) {

		Integer[] left = new Integer[arr.length];
		Integer[] right = new Integer[arr.length];

		left[0] = 1;
		right[arr.length - 1] = 1;

		for (int i = 1; i < arr.length; i++) {

			left[i] = arr[i - 1] * left[i - 1];

		}

		for (int i = arr.length - 2; i >= 0; i--) {

			right[i] = arr[i + 1] * right[i + 1];

		}

		for (int i = 0; i < arr.length; i++) {

			if (i == 0) {

				arr[i] = right[i];

			} else if (i == arr.length - 1) {

				arr[i] = left[i];

			} else {

				arr[i] = left[i] * right[i];

			}

		}

		return arr;

	}

	public static void main(String[] args) {

		Main obj = new Main();

		Integer[] arr = { 3, 2, 4, 1, 3 };
		// Integer[] arr = {3,2,4,1,3}; // [24, 36, 18, 72, 24]

		Integer[] array = obj.ProExSelf(arr);

		System.out.println(Arrays.toString(array));

	}

}
