import java.util.*;
import java.util.stream.*;

public class Main {

	public static Integer RomanToInteger(String s, Map<Character, Integer> hashmap) {

		Integer result = 0;

		for (int i = 0; i < s.length(); i++) {

			if (i + 1 < s.length() && hashmap.get(s.charAt(i)) < hashmap.get(s.charAt(i + 1))) {

				result -= hashmap.get(s.charAt(i));

			} else {

				result += hashmap.get(s.charAt(i));
			}

		}

		return result;

	}

	public static void main(String[] args) {

		Main obj = new Main();

		// OUTPUT : 1947
		String s = "MCMXLVII";

		Map<Character, Integer> hashmap = new HashMap<Character, Integer>();

		hashmap.put('I', 1);
		hashmap.put('V', 5);
		hashmap.put('X', 10);
		hashmap.put('L', 50);
		hashmap.put('C', 100);
		hashmap.put('D', 500);
		hashmap.put('M', 1000);

		Integer result = obj.RomanToInteger(s, hashmap);

		System.out.println(result);

	}

}
