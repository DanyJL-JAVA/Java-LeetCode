import java.util.*;
import java.util.stream.*;

public class Main {

	public static boolean permutationString(String s1, String s2) {

		Map<Character, Integer> Need = new HashMap<Character, Integer>();
		Map<Character, Integer> Have = new HashMap<Character, Integer>();

		for (int i = 0; i < s1.length(); i++) {

			char a = s1.charAt(i);

			if (!Need.containsKey(a)) {

				Need.put(a, 0);

			}

			Need.put(a, Need.get(a) + 1);

		}

		//////

		Integer start = 0;
		Integer end = 0;

		while (end < s2.length()) {

			char a = s2.charAt(end);

			// 1

			if (!Need.containsKey(a)) {

				Have.clear();
				end += 1;
				start = end;
				continue;

			}

			// 2
			if (!Have.containsKey(a)) {

				Have.put(a, 0);

			}

			Have.put(a, Have.get(a) + 1);

			// 3

			while (Need.get(a) < Have.get(a)) {

				char startChar = s2.charAt(start);

				Have.put(startChar, Have.get(startChar) - 1);

				start += 1;

			}

			Integer distance = (end - start) + 1;

			if (distance == s1.length()) {

				String str = s2.substring(start, end + 1);

				System.out.println(str);

				return true;

			}

			end += 1;

		}

		return false;

	}

	public static void main(String[] args) {

		String s1 = "rrb";
		String s2 = "Abacalabrrpto";

		// Output : true --> brr

		Main obj = new Main();

		boolean result = obj.permutationString(s1, s2);

		System.out.println(result);

	}

}
