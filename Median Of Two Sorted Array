import java.util.*;
import java.util.stream.*;

public class Main {

	public static double MedianOfTwoSortedArray(Integer[] arr1, Integer[] arr2) {

		// First we need to Take the Small length array
		if (arr1.length > arr2.length) {

			Integer[] temp = arr1;
			arr1 = arr2;
			arr2 = temp;

		}
		//

		Integer start = 0;
		Integer end = arr1.length;

		while (start <= end) { // Don't forget to give = equal in this.

			Integer Intersection1 = (end + start) / 2;
			Integer Intersection2 = (arr1.length + arr2.length + 1) / 2 - Intersection1;

			Integer left1 = Intersection1 == 0 ? Integer.MIN_VALUE : arr1[Intersection1 - 1];
			Integer right1 = Intersection1 == arr1.length ? Integer.MAX_VALUE : arr1[Intersection1];

			Integer left2 = Intersection2 == 0 ? Integer.MIN_VALUE : arr2[Intersection2 - 1];
			Integer right2 = Intersection2 == arr2.length ? Integer.MAX_VALUE : arr2[Intersection2];

			if (left1 > right2) {

				end = Intersection1 - 1;

			} else if (left2 > right1) {

				start = Intersection1 + 1;

			} else {

				if ((arr1.length + arr2.length) % 2 == 0) {

					return (Math.max(left1, left2) + Math.min(right1, right2)) / 2.0;

				} else {

					return Math.max(left1, left2);
				}

			}

		}

		return -1;

	}

	public static void main(String[] args) {

		Main obj = new Main();

		Integer[] arr1 = { -5, 3, 6, 12, 15 };
		Integer[] arr2 = { -12, -10, -6, -3, 4, 10 };

		// output : 3

//		Integer[] arr1 = { 1 };
//		Integer[] arr2 = { 2, 4, 5, 6, 7 };

		// output : 4.5

		double result = obj.MedianOfTwoSortedArray(arr1, arr2);

		System.out.println(result);

	}

}
