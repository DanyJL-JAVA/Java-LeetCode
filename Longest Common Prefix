public class Main {

    public static String LongestPrefix(String[] arr){


        Arrays.sort(arr);

        String s1 = arr[0];
        String s2 = arr[arr.length - 1];

        String str = "";

        for(int i = 0; i < s1.length(); i++){

            if(s1.charAt(i) == s2.charAt(i)){

                str += s1.charAt(i);

            }
            else{
                break;
            }


        }

        return str;

    }

    public static void main(String[] args) {

        Main obj =  new Main();


