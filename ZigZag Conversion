public class Main {

	public static String zigzag(String s) {

		String str = "";
		Integer num = 4;

		for (int i = 0; i < num; i++) {

			int j = i;
			int flag = 1;

			while (j < s.length()) {

				str += s.charAt(j);

				if (i == 0 || i == num - 1) {

					j += 2 * (num - 1);

				} else if (flag % 2 != 0) {

					j += 2 * (num - 1) - (2 * i);

				} else {

					j += (2 * i);

				}

				flag++;

			}

		}

		return str;

	}

	public static void main(String[] args) {

		Main obj = new Main();

		// output : PINALSIGYAHRPI

		String s = "pay pal is hiring";

		s = s.replaceAll("\\s+", "").toUpperCase();

		String result = obj.zigzag(s);

		System.out.println(result);

	}

}
