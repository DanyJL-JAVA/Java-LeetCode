import java.util.*;
import java.util.stream.*;

public class Main {

	public static Integer BestTimeToBuyandSellStock(Integer[] arr) {

		Integer min = Integer.MAX_VALUE;
		Integer max = Integer.MIN_VALUE;

		for (int i = 0; i < arr.length; i++) {

			min = Math.min(min, arr[i]);
			max = Math.max(max, arr[i] - min);
		}

		return max;

	}

	public static void main(String[] args) {

		Main obj = new Main();

		Integer[] arr = { 7, 1, 5, 3, 6, 4 }; // output : 5
//		 Integer[] arr = {7,6,4,3,1}; // output : 0

		Integer result = obj.BestTimeToBuyandSellStock(arr);

		System.out.println(result);

	}

}
